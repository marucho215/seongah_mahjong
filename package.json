{
  "name": "sanma-riichi-engine",
  "version": "1.1.0",
  "description": "Riichi mahjong simulation engine (sanma and yonma) with CharacterAI opponents and a human-play GUI/CLI",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/comparativeCharacterSim.ts",
    "sim:yonma": "tsx src/sim/yonmaCharacterSim.ts",
    "sim:ari-ab": "tsx src/sim/ariSpecialLogicAB.ts",
    "analyze:ari": "tsx src/sim/ariDiagnosticStats.ts",
    "validate": "tsx src/sim/validationHarness.ts",
    "play": "tsx src/cli/humanPlayCli.ts",
    "play:gui": "tsx src/gui/server.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "playwright": "1.56.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
